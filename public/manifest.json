{
  "name": ".malash",
  "version": "1.0.0",
  "description": "Autoscroll for reading manga, comics, and articels",
  "manifest_version": 3,

  "icons": {
    "16": "/android-chrome-192x192.png",
    "32": "/android-chrome-192x192.png",
    "48": "/android-chrome-192x192.png",
    "128": "/android-chrome-192x192.png",
    "192": "/android-chrome-192x192.png",
    "512": "/android-chrome-512x512.png"
  },

  "permissions": ["storage", "activeTab"],
  "action": {
    "default_icon": {
      "16": "/android-chrome-192x192.png",
      "32": "/android-chrome-192x192.png",
      "48": "/android-chrome-192x192.png",
      "128": "/android-chrome-192x192.png",
      "192": "/android-chrome-192x192.png",
      "512": "/android-chrome-512x512.png"
    },

    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "scripts": ["src/background.ts"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ],
  "commands": {
    "toggle-autoscroll": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Toggle Autoscroll On/Off"
    }
  }
}
